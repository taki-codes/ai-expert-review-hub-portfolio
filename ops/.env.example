# Application
APP_ENV=development
PORT=3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=file:./dev.db

# OpenAI / GPT normalization
GPT_ADAPTER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_MS=45000

# Gemini first-pass review
GEMINI_ADAPTER_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000

# Notebook knowledge registry
NOTEBOOK_PROVIDER=notebooklm
DEFAULT_NOTEBOOK_ID=

# Figma read-only context
FIGMA_ADAPTER_MODE=mock
FIGMA_ACCESS_TOKEN=
FIGMA_BASE_URL=https://api.figma.com
FIGMA_TIMEOUT_MS=15000

# Figma MCP (optional reference only)
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp
ENABLE_FIGMA=false

# Security tools
ENABLE_SEMGREP=true
ENABLE_ZAP=true
ENABLE_CODEQL=false

# Paths
ARTIFACT_ROOT=./data/review-runs
